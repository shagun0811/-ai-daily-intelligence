# Copy this file to .env and adjust values.
# Never commit .env.

# --- Database ---
DATABASE_URL=sqlite:///./data/aggregator.db

# --- LLM (used from Phase 5; mock requires no model download) ---
LLM_PROVIDER=mock
LLM_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# --- Embeddings (used from Phase 3/4) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_PROVIDER=auto

# --- Pipeline limits ---
SEMANTIC_DUPLICATE_THRESHOLD=0.88
TITLE_SIMILARITY_THRESHOLD=0.92
MAX_ARTICLES_PER_SOURCE=40
MAX_LLM_ITEMS=30
REPORT_MAX_ITEMS=15
HTTP_TIMEOUT_SECONDS=20
EXTRACT_FULL_TEXT=true
MIN_CLEANED_TEXT_CHARS=400
MAX_FULL_TEXT_EXTRACTS=25

# --- Runtime ---
LOG_LEVEL=INFO
SCHEDULER_ENABLED=false
SCHEDULER_HOUR=17
SCHEDULER_MINUTE=0
SCHEDULER_TIMEZONE=Asia/Kolkata
CLOUDFLARE_AUTO_DEPLOY=false
CLOUDFLARE_PAGES_PROJECT=ai-daily-intelligence
CLOUDFLARE_DEPLOY_TIMEOUT_SECONDS=300
