{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Preview briefing in VS Code",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["scripts/preview_site.py"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "preview",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Serving |already running|Opened Simple Browser"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Open live Cloudflare site in VS Code",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": [
        "scripts/open_vscode_browser.py",
        "https://ai-daily-intelligence.pages.dev"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent"
      }
    }
  ]
}
